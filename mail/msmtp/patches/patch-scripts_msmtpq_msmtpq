--- scripts/msmtpq/msmtpq	2023-10-08 00:44:16.508911330 +0000
+++ scripts/msmtpq/msmtpq
@@ -84,8 +84,8 @@ MSMTPQ_Q=${MSMTPQ_Q:-${Q:-~/.msmtp.queue
